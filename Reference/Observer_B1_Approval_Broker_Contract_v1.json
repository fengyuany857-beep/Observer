{
  "contract_id": "observer.backend.approval-broker.v1",
  "phase": "B1",
  "revision": "B1-2026-10-06-R1",
  "status": "CANDIDATE_CONTRACT",
  "depends_on": [
    "observer.backend.authority-time.v1",
    "observer.b0-a6.compatibility.v1"
  ],
  "scope": "Authoritative lifecycle for one bounded user approval request. No Session minting, credential issuance, UI rendering, job control, or production deployment.",
  "owner": "VCW_CONTROL_PLANE_BACKEND",
  "clock_authority": "VCW_SERVER_CLOCK",
  "state_machine": {
    "states": [
      "PENDING",
      "APPROVED",
      "DENIED",
      "EXPIRED",
      "CONSUMED",
      "INVALIDATED",
      "FAILED",
      "OUTCOME_UNKNOWN"
    ],
    "allowed_transitions": {
      "PENDING": ["APPROVED", "DENIED", "EXPIRED", "INVALIDATED", "FAILED", "OUTCOME_UNKNOWN"],
      "APPROVED": ["CONSUMED", "EXPIRED", "INVALIDATED", "FAILED", "OUTCOME_UNKNOWN"],
      "DENIED": [],
      "EXPIRED": [],
      "CONSUMED": [],
      "INVALIDATED": [],
      "FAILED": [],
      "OUTCOME_UNKNOWN": ["APPROVED", "DENIED", "EXPIRED", "CONSUMED", "INVALIDATED", "FAILED"]
    }
  },
  "request_identity": {
    "required_fields": [
      "approval_id",
      "request_attempt_id",
      "requester_principal",
      "project_id",
      "requested_scope",
      "action_class",
      "effect_class",
      "created_at",
      "expires_at",
      "state",
      "state_version",
      "request_fingerprint"
    ],
    "rules": [
      "approval_id is public identity, never a credential",
      "request_attempt_id identifies one GPT access attempt",
      "request_fingerprint binds normalized project/scope/action/effect",
      "same idempotency key plus same fingerprint returns the same logical approval",
      "same idempotency key plus different fingerprint is IDEMPOTENCY_CONFLICT",
      "raw grant/session credentials are forbidden"
    ]
  },
  "configuration": {
    "approval_ttl_seconds": {
      "required": true,
      "default": null,
      "rule": "Must be server configuration. Do not reuse GPT 30s wait or legacy Grant TTL implicitly."
    },
    "gpt_wait_window_seconds": {
      "source": "B0",
      "value": 30,
      "authority_effect": "NONE"
    }
  },
  "operations": {
    "create_request": {
      "input": [
        "request_attempt_id",
        "requester_principal",
        "project_id",
        "requested_scope",
        "action_class",
        "effect_class",
        "idempotency_key"
      ],
      "preconditions": [
        "approval_ttl_seconds configured",
        "normalized scope is non-empty",
        "requester is authenticated by upstream control plane"
      ],
      "postconditions": [
        "PENDING approval exists",
        "created_at/expires_at are server timestamps",
        "state_version starts at 1",
        "append-only audit event may be emitted but is not authority truth"
      ]
    },
    "get_request": {
      "input": ["approval_id"],
      "rule": "Read authoritative store and apply expiry before returning state."
    },
    "list_pending": {
      "rule": "Read authoritative store; expired rows cannot be returned as PENDING."
    },
    "decide": {
      "input": [
        "approval_id",
        "decision",
        "decision_attempt_id",
        "expected_state_version",
        "decider_principal"
      ],
      "decision_values": ["ALLOW", "DENY"],
      "preconditions": [
        "current state is PENDING",
        "server_now < expires_at",
        "expected_state_version equals current state_version",
        "decider is authenticated and permitted for this approval"
      ],
      "postconditions": [
        "ALLOW -> APPROVED",
        "DENY -> DENIED",
        "state_version increments exactly once",
        "same decision_attempt_id is idempotent",
        "different decision after terminal decision is rejected"
      ]
    },
    "consume_for_session": {
      "visibility": "INTERNAL_B2_ONLY",
      "preconditions": [
        "current state is APPROVED",
        "server_now < expires_at",
        "session mint authority chain is unique for approval_id"
      ],
      "postconditions": [
        "CONSUMED only after authoritative Session mint commit is proven",
        "one approval cannot authorize two Sessions",
        "mint failure before authoritative commit leaves approval APPROVED unless separately invalidated/expired",
        "ambiguous cross-store outcome enters reconciliation; never assume CONSUMED"
      ]
    },
    "expire": {
      "rule": "PENDING or APPROVED becomes EXPIRED when server_now >= expires_at and no authoritative consume commit exists."
    },
    "invalidate": {
      "rule": "Explicit authority revocation or scope/target invalidation may move reusable states to INVALIDATED with reason evidence."
    }
  },
  "api_candidate": {
    "public_control_surface": [
      "POST /observer/control/v1/access-requests",
      "GET /observer/control/v1/approvals/{approval_id}",
      "GET /observer/control/v1/approvals?state=PENDING",
      "POST /observer/control/v1/approvals/{approval_id}/decision"
    ],
    "internal_surface": [
      "consume_for_session(approval_id, mint_attempt_id, session_ref)"
    ],
    "note": "Candidate paths only. They are not claims about current VCW production endpoints."
  },
  "hard_invariants": [
    "GPT_WAIT_TIMEOUT_DOES_NOT_EXPIRE_APPROVAL",
    "GPT_CANNOT_SELF_APPROVE",
    "APPROVAL_APPROVED_DOES_NOT_EQUAL_SESSION_MINTED",
    "APPROVAL_CONSUME_AT_MOST_ONCE",
    "APPROVAL_ID_IS_NOT_A_CREDENTIAL",
    "CLIENT_CLOCK_CANNOT_EXPIRE_OR_EXTEND_APPROVAL",
    "STALE_EXPECTED_STATE_VERSION_CANNOT_MUTATE",
    "EVENT_IS_NOT_APPROVAL_TRUTH",
    "CACHED_APPROVAL_CANNOT_AUTHORIZE_SESSION",
    "DENIED_EXPIRED_CONSUMED_INVALIDATED_FAILED_NEVER_RETURN_TO_PENDING",
    "SESSION_MINT_FAILURE_DOES_NOT_SILENTLY_CONSUME_APPROVAL",
    "AMBIGUOUS_MINT_RESULT_MUST_RECONCILE_BEFORE_RETRY"
  ],
  "manual_fallback": {
    "legacy_grant": "MANUAL_EMERGENCY_OR_COMPATIBILITY_FALLBACK",
    "rule": "Legacy Grant must not become a second primary approval authority path."
  },
  "out_of_scope": [
    "Observer UI",
    "push notification delivery",
    "Session credential creation",
    "Session revoke/logout",
    "Job/Operation lifecycle",
    "Production schema migration",
    "Production deployment"
  ]
}
