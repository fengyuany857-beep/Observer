      "INPUTS_UNBOUND"
    ],
    [
      "RunStatusSnapshot.runtimePhase",
      "task.activity/progress or explicit phase",
      "UNBOUND"
    ],
    [
      "RunStatusSnapshot.stage",
      "structured task.progress",
      "SCHEMA_PARTIAL"
    ],
    [
      "RunStatusSnapshot.currentOperation",
      "structured task.activity",
      "SCHEMA_PARTIAL"
    ],
    [
      "RunStatusSnapshot.elapsedMS",
      "explicit timing only",
      "UNBOUND_BLOCKER"
    ],
    [
      "RunStatusSnapshot.startedAt",
      "explicit start timestamp",
      "UNBOUND"
    ],
    [
      "RunStatusSnapshot.endedAt",
      "explicit terminal timestamp",
      "UNBOUND"
    ],
    [
      "RunStatusSnapshot.heartbeats",
      "authority-preserving liveness projection",
      "UNBOUND"
    ],
    [
      "RunStatusSnapshot.tests",
      "authoritative test summary",
      "UNBOUND_MODULE"
    ],
    [
      "RunStatusSnapshot.checkpoint",
      "Director checkpoint read surface",
      "ENDPOINT_UNCONFIRMED"
    ],
    [
      "RunStatusSnapshot.bundle",
      "artifact/evidence projection",
      "UNBOUND_MODULE"
    ],
    [
      "RunStatusSnapshot.presentationStatus",
      "explicit delivery/presentation authority only",
      "NO_VCW_AUTHORITY_PROVEN"
    ],
    [
      "RunStatusSnapshot.lastEvent",
      "Director EventEnvelope",
      "PARTIAL_EPOCH_UNBOUND"
    ],
    [
      "RunStatusSnapshot.updatedAt",
      "task.updated_at",
      "LOSSLESS"
    ]
