  "detail_surfaces": {
    "timeline": {
      "authority": "DIRECTOR_EVENT_LEDGER",
      "event_fields": [
        "event_id",
        "schema_version",
        "event_type",
        "task_id",
        "execution_id?",
        "step_id?",
        "aggregate_sequence",
        "correlation_id?",
        "causation_id?",
        "occurred_at",
        "payload"
      ]
    },
    "tests": {
      "authority": "DIRECTOR_TEST_EVIDENCE_OR_VERIFICATION_PROJECTION",
      "binding": "UNCONFIRMED",
      "cursor": true
    },
    "checkpoints_artifacts": {
      "checkpoint_authority": "EXECUTION_DIRECTOR",
      "artifact_authority": "EVIDENCE_BUNDLE_OR_RUNNER_TARGET_OBSERVATION",
      "binding": "PARTIAL",
      "cursor": true
    },
    "logs": {
      "authority": "SOURCE_LOG_STREAM_WITH_SOURCE_TAG",
      "binding": "UNCONFIRMED",
      "cursor": true
    },
    "raw_events": {
      "authority": "DIRECTOR_EVENT_LEDGER",
      "stable_identity": true,
      "cursor": true
    }
  },
  "rest_product_contract": {
    "status": "FROZEN_CLIENT_SURFACE_ENDPOINT_BINDING_PROVISIONAL",
    "base": "/observer/v1",
    "endpoints": [
      "GET /snapshot",
      "GET /tasks?cursor&limit&scope&query",
      "GET /tasks/{task_id}",
      "GET /tasks/{task_id}/timeline?cursor&limit",
      "GET /tasks/{task_id}/tests?cursor&limit",
      "GET /tasks/{task_id}/checkpoints-artifacts?cursor&limit",
      "GET /tasks/{task_id}/logs?cursor&limit&direction&query",
      "GET /tasks/{task_id}/events?cursor&limit"
    ],
    "disclaimer": "Product contract only; does not assert current VCW deployment already exposes these exact HTTP paths."
  },
  "event_stream": {
    "contract_version": "observer.events.v1",
    "transport_abstraction": "WebSocket; URLSessionWebSocketTask is an implementation candidate",
    "authority": "INVALIDATION_HINT_ONLY",
    "envelope": [
      "event_id",
      "cursor",
      "snapshot_revision?",
      "task_id?",
      "event_type",
      "occurred_at",
      "changed_resources?"
    ],
    "rule": "Events never directly overwrite canonical task truth; refetch revisioned resource/snapshot. Deduplicate event_id."
  },
  "reconciliation": {
    "disconnect": "serve last-good snapshot as CACHED; keep connection failure separate",
    "reconnect": "refetch authoritative snapshot before ONLINE truth",
    "out_of_order_event": "trigger refetch; do not apply as truth",
    "duplicate_event": "deduplicate event_id",
    "schema_unknown": "keep last-good known truth and mark affected module unavailable",
    "partial_failure": "preserve unaffected modules"
  },
  "gaps": [
    [
      "GAP-A1-001",
      "P0_FOR_LIVE_WIRING",
      "Current Swift ExecutionStatus is not lossless for director.public.v1"
    ],
    [
      "GAP-A1-002",
      "P0_FOR_LIVE_WIRING",
      "workspaceID has no safe public-contract binding; migrate to projectID"
    ],
    [
      "GAP-A1-003",
      "P1",
      "Health/heartbeat/elapsed sources and thresholds are unproven"
    ],
    [
      "GAP-A1-004",
      "P1",
      "Tests/checkpoint/artifact/log deployed endpoint bindings are unconfirmed"
    ],
    [
      "GAP-A1-005",
      "P1",
      "PresentationStatus has no proven VCW authority; default UNKNOWN"
    ],
    [
      "GAP-A1-006",
      "P1",
      "Existing lastEvent.epoch is not backed by known Director EventEnvelope"
    ],
    [
      "GAP-A1-007",
      "P1",
      "No authoritative focus pointer proven"
    ]
  ],
  "phase_gate": {
    "V3_A1": "CLIENT_CONTRACT_FROZEN_WITH_PARTIAL_BACKEND_BINDING",
    "V3_A2_allowed": true,
    "V3_A2": [
      "Preserve raw Director task state/outcome/recovery/access in Swift domain",
      "Replace/deprecate workspaceID with projectID",
      "Introduce ObserverDataSource abstraction",
      "Retain FixtureDataSource for Preview/Test"
    ],
    "network_transport_open": false,
    "V3_A3_live_wiring_blockers": [
      "GAP-A1-001",
      "GAP-A1-002",
      "GAP-A1-003",
      "GAP-A1-004"
    ]
  }
