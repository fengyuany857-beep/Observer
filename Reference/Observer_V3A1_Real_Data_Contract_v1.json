{
  "contract_id": "observer.read.v1",
  "contract_revision": "V3-A1-2026-10-05",
  "status": "CLIENT_CONTRACT_FROZEN_BACKEND_BINDING_PARTIAL",
  "scope": "Observer iOS read-only real-data projection. Command plane excluded.",
  "baseline": {
    "observer_commit": "df6b482a90dd555d01d39ca50c4f51f7448cea73",
    "vcw_live": {
      "gateway_mode": "V2",
      "store_schema_version": 3,
      "journal_mode": "wal",
      "quick_check": "ok",
      "runner": "ONLINE"
    },
    "vcw_deep_source": "UNAVAILABLE_CURRENT_SESSION",
    "director_public": "director.public.v1/v1.1 prior project baseline"
  },
  "authority": {
    "task": "EXECUTION_DIRECTOR",
    "access_session_queue_lock": "GATEWAY",
    "action_result_cas_sha_job_reconcile": "RUNNER",
    "rules": [
      "EVENT_IS_NOT_TRUTH",
      "OBSERVER_IS_PROJECTION_ONLY",
      "TASK_SESSION_EXECUTION_AND_RUNNER_JOB_MUST_REMAIN_SEPARATE",
      "OFFLINE_IS_NOT_FAILED",
      "STALE_IS_NOT_FAILED",
      "SUSPECTED_STUCK_IS_NOT_DEAD",
      "COMPLETED_IS_NOT_PRESENTED",
      "MISSING_IS_UNKNOWN_OR_OMITTED_NOT_NORMAL"
    ]
  },
  "director_public_state": {
    "fields": [
      "contract_version",
      "task_id",
      "project_id",
      "state",
      "state_class",
      "state_version",
      "terminal",
      "settled",
      "outcome",
      "recovery_state",
      "wait_reason?",
      "blocking_reason?",
      "access?",
      "summary?",
      "activity?",
      "progress?",
      "decision?",
      "resume?",
      "cancellable",
      "result?",
      "evidence_bundle?",
      "poll_after_ms?",
      "created_at",
      "updated_at"
    ],
    "state": [
      "CREATED",
      "WAITING",
      "RUNNING",
      "NEEDS_DECISION",
      "PAUSED",
      "RECONCILING",
      "CANCELLING",
      "TERMINAL"
    ],
    "outcome": [
      "UNRESOLVED",
      "SUCCEEDED",
      "PARTIAL",
      "FAILED",
      "OUTCOME_UNKNOWN",
      "BLOCKED",
      "CANCELLED"
    ],
    "recovery": [
      "CLEAN",
      "DIRTY_KNOWN",
      "RECONCILIATION_REQUIRED",
      "RECOVERY_REQUIRED",
      "RECOVERY_BLOCKED"
    ],
    "access": [
      "PENDING",
      "AUTHORIZED",
      "DENIED",
      "EXPIRED",
      "NOT_REQUIRED",
      "UNKNOWN"
    ]
  },
  "identity": {
    "observer_run_semantics": "PUBLIC_TASK_PROJECTION",
    "run_id_source": "task_id",
    "guard": "Never use execution_id, session_id, action/effect_id or runner job_id as runID.",
    "current_workspaceID": "SEMANTIC_MISMATCH",
    "replacement": "projectID <- PublicTaskState.project_id"
  },
  "snapshot": {
    "contract_version": "observer.snapshot.v1",
    "fields": {
      "snapshot_revision": "projection revision",
      "connection_state": "Observer transport + Gateway access; separate from task truth",
      "focus_task_id": "OPTIONAL_UNBOUND; only when explicit authoritative source exists",
      "tasks": "observer.task.v1[]",
      "observed_at": "projection observation time",
      "last_sync_at": "last successful authoritative snapshot receipt",
      "provenance": "LIVE|CACHED"
    }
  },
  "task": {
    "contract_version": "observer.task.v1",
    "required": {
      "task_id": "PublicTaskState.task_id",
      "project_id": "PublicTaskState.project_id",
      "state": "PublicTaskState.state",
      "state_version": "PublicTaskState.state_version",
      "terminal": "PublicTaskState.terminal",
      "settled": "PublicTaskState.settled",
      "outcome": "PublicTaskState.outcome",
      "recovery_state": "PublicTaskState.recovery_state",
      "cancellable": "PublicTaskState.cancellable",
      "created_at": "PublicTaskState.created_at",
      "updated_at": "PublicTaskState.updated_at"
    },
    "optional": {
      "state_class": "PublicTaskState.state_class",
      "access": "PublicTaskState.access",
      "wait_reason": "PublicTaskState.wait_reason",
      "blocking_reason": "PublicTaskState.blocking_reason",
      "summary": "PublicTaskState.summary",
      "activity": "PublicTaskState.activity",
      "progress": "PublicTaskState.progress",
      "decision": "PublicTaskState.decision (READ ONLY)",
      "resume": "PublicTaskState.resume (READ ONLY)",
      "result": "PublicTaskState.result",
      "evidence_bundle": "PublicTaskState.evidence_bundle",
      "project_name": "project registry display metadata; source not yet bound"
    }
  },
  "swift_mapping": [
    [
      "ObserverSnapshot.connectionState",
      "snapshot.connection_state",
      "LOSSLESS"
    ],
    [
      "ObserverSnapshot.authoritativeFocusRunID",
      "snapshot.focus_task_id",
      "UNBOUND_OPTIONAL"
    ],
    [
      "RunStatusSnapshot.runID",
      "task.task_id",
      "LOSSLESS_ALIAS"
    ],
    [
      "RunStatusSnapshot.workspaceID",
      "task.project_id",
      "SEMANTIC_NAME_MISMATCH"
    ],
    [
      "RunStatusSnapshot.projectName",
      "project registry name",
      "SOURCE_UNKNOWN"
    ],
    [
      "RunStatusSnapshot.executionStatus",
      "task.state + outcome + decision/access/resume",
      "LOSSY_BLOCKER"
    ],
    [
      "RunStatusSnapshot.runtimeHealth",
