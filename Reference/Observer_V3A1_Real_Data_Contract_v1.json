  "safe_legacy_display_examples": [
    [
      "CREATED",
      "UNRESOLVED",
      "PENDING"
    ],
    [
      "RUNNING",
      "UNRESOLVED",
      "RUNNING"
    ],
    [
      "TERMINAL",
      "SUCCEEDED",
      "COMPLETED"
