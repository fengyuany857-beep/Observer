    [
      "TERMINAL",
      "FAILED",
      "FAILED"
    ],
    [
      "TERMINAL",
      "CANCELLED",
      "ABORTED"
    ]
  ],
  "must_not_force_into_current_ExecutionStatus": [
    "WAITING without explicit reason",
    "NEEDS_DECISION unless decision_class proves approval semantics",
    "PAUSED without explicit resumability",
    "RECONCILING",
    "CANCELLING",
    "TERMINAL+PARTIAL",
    "TERMINAL+BLOCKED",
    "TERMINAL+OUTCOME_UNKNOWN"
